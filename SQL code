Ανάκτηση Δεδομένων από Δύο ή Περισσότερους Πίνακες

SELECT p.PRESCRIPTION_ID, p.ISSUE_DATE,d.D_NAME AS DRUG_NAME, pd.QUANTITY
FROM PRESCRIPTION p, PRESCRIPTION_DETAIL pd, DRUG d
WHERE p.PRESCRIPTION_ID = pd.PRESCRIPTION_PRESCRIPTION_ID AND pd.DRUG_DRUG_ID = d.DRUG_ID AND p.ISSUE_DATE BETWEEN DATE '2024-01-01' AND DATE '2024-12-31';

Ανάκτηση Στοιχείων Ασθενών που Παρακολουθούνται από Συγκεκριμένο Ιατρό

SELECT p.P_FNAME AS "ΟΝΟΜΑ ΑΣΘΕΝΟΥΣ", p.P_LNAME AS "ΕΠΩΝΥΜΟ ΑΣΘΕΝΟΥΣ", d.FIRST_NAME || ' ' || d.LAST_NAME AS "ΙΑΤΡΟΣ"
FROM DOCTOR d, PATIENT p
WHERE d.DOCTOR_ID = p.DOCTOR_DOCTOR_ID AND d.FIRST_NAME = 'ΠΕΤΡΟΣ' AND d.LAST_NAME = 'ΠΕΡΙΜΕΝΗΣ';

Χρήση Συναρτήσεων Ομαδοποίησης 

Καταμέτρηση νοσηλευτών ανά θάλαμο

SELECT WARD_WARD_ID, COUNT(NURSE_ID) AS TOTAL_NURSES
FROM NURSE
GROUP BY WARD_WARD_ID;

Πλήθος χορηγήσεων συγκεκριμένων φαρμάκων από ιατρό

SELECT d.D_NAME AS "ΦΑΡΜΑΚΟ", COUNT(pd.PRESCRIPTION_PRESCRIPTION_ID) AS "ΠΛΗΘΟΣ ΧΟΡΗΓΗΣΕΩΝ"
FROM DOCTOR doc, PATIENT p, PRESCRIPTION pr, PRESCRIPTION_DETAIL pd, DRUG d
WHERE doc.DOCTOR_ID = p.DOCTOR_DOCTOR_ID AND p.PATIENT_ID = pr.PATIENT_PATIENT_ID AND pr.PRESCRIPTION_ID = pd.PRESCRIPTION_PRESCRIPTION_ID AND pd.DRUG_DRUG_ID = d.DRUG_ID AND doc.FIRST_NAME = 'ΠΕΤΡΟΣ' AND doc.LAST_NAME = 'ΠΕΡΙΜΕΝΗΣ' AND d.D_NAME IN ('Paracetamol', 'Ibuprofen')
GROUP BY d.D_NAME;































































