 Οι Πίνακες

 CREATE TABLE "DOCTOR" 
   (	"FIRST_NAME" VARCHAR2(20) NOT NULL ENABLE, 
	"LAST_NAME" VARCHAR2(20), 
	"DOCTOR_ID" NUMBER(5,0), 
	"SSN" VARCHAR2(15), 
	"ADDRESS" VARCHAR2(20), 
	"PHONE" VARCHAR2(15) NOT NULL ENABLE, 
	"SPECIALTY" VARCHAR2(20) NOT NULL ENABLE, 
	 CONSTRAINT "DOCTOR_PK" PRIMARY KEY ("DOCTOR_ID")
  USING INDEX  ENABLE, 
	 CONSTRAINT "DOCTOR_SSN_UN" UNIQUE ("SSN")
  USING INDEX  ENABLE
   ) ;

 CREATE TABLE "DRUG" 
   (	"D_NAME" VARCHAR2(20), 
	"DRUG_ID" NUMBER(5,0), 
	"RECOM_DAILY_DOSE" NUMBER(5,0), 
	 CONSTRAINT "DRUG_PK" PRIMARY KEY ("DRUG_ID")
  USING INDEX  ENABLE, 
	 CONSTRAINT "DRUG_D_NAME_UN" UNIQUE ("D_NAME")
  USING INDEX  ENABLE
   ) ;

  CREATE TABLE "HOSPITALIZATION" 
   (	"HOSP_ID" NUMBER(5,0), 
	"ADMITION_DATE" DATE DEFAULT (sysdate), 
	"DISCHARGE_DATE" DATE DEFAULT (sysdate), 
	"STATUS" VARCHAR2(20), 
	"PATIENT_PATIENT_ID" NUMBER(5,0) NOT NULL ENABLE, 
	"WARD_WARD_ID" NUMBER(5,0) NOT NULL ENABLE, 
	"DOCTOR_DOCTOR_ID" NUMBER(5,0) NOT NULL ENABLE, 
	 CONSTRAINT "HOSPITALIZATION_PK" PRIMARY KEY ("HOSP_ID")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "HOSPITALIZATION" ADD CONSTRAINT "HOSPITALIZATION_DOCTOR_FK" FOREIGN KEY ("DOCTOR_DOCTOR_ID")
	  REFERENCES "DOCTOR" ("DOCTOR_ID") ENABLE;
  ALTER TABLE "HOSPITALIZATION" ADD CONSTRAINT "HOSPITALIZATION_PATIENT_FK" FOREIGN KEY ("PATIENT_PATIENT_ID")
	  REFERENCES "PATIENT" ("PATIENT_ID") ENABLE;
  ALTER TABLE "HOSPITALIZATION" ADD CONSTRAINT "HOSPITALIZATION_WARD_FK" FOREIGN KEY ("WARD_WARD_ID")
	  REFERENCES "WARD" ("WARD_ID") ENABLE;

  CREATE TABLE "NURSE" 
   (	"F_NAME" VARCHAR2(20), 
	"L_NAME" VARCHAR2(20), 
	"NURSE_ID" NUMBER(5,0), 
	"SSN" VARCHAR2(15), 
	"B_DATE" DATE, 
	"PHONE" VARCHAR2(15), 
	"ADDRESS" VARCHAR2(20), 
	"SUPERVISOR_ID" NUMBER(5,0), 
	"WARD_WARD_ID" NUMBER(5,0), 
	 CONSTRAINT "NURSE_PK" PRIMARY KEY ("NURSE_ID")
  USING INDEX  ENABLE, 
	 CONSTRAINT "NURSE_SSN_UN" UNIQUE ("SSN")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "NURSE" ADD CONSTRAINT "NURSE_WARD_FK" FOREIGN KEY ("WARD_WARD_ID")
	  REFERENCES "WARD" ("WARD_ID") ENABLE;

  CREATE TABLE "PATIENT" 
   (	"P_FNAME" VARCHAR2(20) NOT NULL ENABLE, 
	"P_LNAME" VARCHAR2(20) NOT NULL ENABLE, 
	"PATIENT_ID" NUMBER(5,0), 
	"PHONE" VARCHAR2(15) NOT NULL ENABLE, 
	"ADDRESS" VARCHAR2(20), 
	"SSN" VARCHAR2(15) NOT NULL ENABLE, 
	"ADMISSION_DATE" DATE DEFAULT (sysdate), 
	"DISCHARGE_DATE" DATE DEFAULT (sysdate), 
	"DOCTOR_DOCTOR_ID" NUMBER(5,0) NOT NULL ENABLE, 
	 CONSTRAINT "PATIENT_PK" PRIMARY KEY ("PATIENT_ID")
  USING INDEX  ENABLE, 
	 CONSTRAINT "PATIENT_SSN_UN" UNIQUE ("SSN")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "PATIENT" ADD CONSTRAINT "PATIENT_DOCTOR_FK" FOREIGN KEY ("DOCTOR_DOCTOR_ID")
	  REFERENCES "DOCTOR" ("DOCTOR_ID") ENABLE;

  CREATE TABLE "PRESCRIPTION" 
   (	"PRESC_NAME" VARCHAR2(20), 
	"PRESCRIPTION_ID" NUMBER(5,0), 
	"ISSUE_DATE" DATE DEFAULT (sysdate) NOT NULL ENABLE, 
	"PATIENT_PATIENT_ID" NUMBER(5,0) NOT NULL ENABLE, 
	"HOSPITALIZATION_HSP_ID" NUMBER(5,0) NOT NULL ENABLE, 
	 CONSTRAINT "PRESCRIPTION_ID" PRIMARY KEY ("PRESCRIPTION_ID")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "PRESCRIPTION" ADD CONSTRAINT "PRESCRIPTION_HOSPITALIZATION_FK" FOREIGN KEY ("HOSPITALIZATION_HSP_ID")
	  REFERENCES "HOSPITALIZATION" ("HOSP_ID") ENABLE;
  ALTER TABLE "PRESCRIPTION" ADD CONSTRAINT "PRESCRIPTION_PATIENT_FK" FOREIGN KEY ("PATIENT_PATIENT_ID")
	  REFERENCES "PATIENT" ("PATIENT_ID") ENABLE;

  CREATE TABLE "PRESCRIPTION_DETAIL" 
   (	"QUANTITY" NUMBER(5,0) NOT NULL ENABLE, 
	"DAILY_DOSE" NUMBER(5,0) NOT NULL ENABLE, 
	"DRUG_DRUG_ID" NUMBER(5,0) NOT NULL ENABLE, 
	"PRESCRIPTION_PRESCRIPTION_ID" NUMBER(5,0) NOT NULL ENABLE, 
	 CHECK (quantity>0) ENABLE, 
	 CONSTRAINT "PRESCRIPTION_DETAIL_PK" PRIMARY KEY ("DRUG_DRUG_ID", "PRESCRIPTION_PRESCRIPTION_ID")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "PRESCRIPTION_DETAIL" ADD CONSTRAINT "PRESCRIPTION_DETAIL_DRUG_FK" FOREIGN KEY ("DRUG_DRUG_ID")
	  REFERENCES "DRUG" ("DRUG_ID") ENABLE;
  ALTER TABLE "PRESCRIPTION_DETAIL" ADD CONSTRAINT "PRESCRIPTION_DETAIL_PRESCRIPTION_FK" FOREIGN KEY ("PRESCRIPTION_PRESCRIPTION_ID")
	  REFERENCES "PRESCRIPTION" ("PRESCRIPTION_ID") ENABLE;

  CREATE TABLE "WARD" 
   (	"WARD_ID" NUMBER(5,0), 
	"NUMBR" NUMBER(5,0) NOT NULL ENABLE, 
	"WING_WING_ID" NUMBER(5,0), 
	 CONSTRAINT "WARD_PK" PRIMARY KEY ("WARD_ID")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "WARD" ADD CONSTRAINT "WARD_WING_FK" FOREIGN KEY ("WING_WING_ID")
	  REFERENCES "WING" ("WING_ID") ENABLE;

  CREATE TABLE "WING" 
   (	"WING_ID" NUMBER(5,0), 
	"NAME" VARCHAR2(20), 
	 CONSTRAINT "WING_PK" PRIMARY KEY ("WING_ID")
  USING INDEX  ENABLE
   ) ;


